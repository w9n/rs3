{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "hardening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPutObjectBytes",
        "bufferedPutObjectBytes",
        "backendMultipartPartBytes",
        "streamReadStallTimeoutSeconds",
        "maxInFlightUploadBodyBytes",
        "maxInFlightDownloadBodyBytes",
        "maxConcurrentConnections",
        "maxConcurrentRequests",
        "requestRateLimitPerSecond"
      ],
      "properties": {
        "maxPutObjectBytes": { "type": "integer", "minimum": 1, "maximum": 53687091200000 },
        "bufferedPutObjectBytes": { "type": "integer", "minimum": 1, "maximum": 53687091200000 },
        "backendMultipartPartBytes": { "type": "integer", "minimum": 5242880, "maximum": 5368709120 },
        "streamReadStallTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "maxInFlightUploadBodyBytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "maxInFlightDownloadBodyBytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "maxConcurrentConnections": { "type": "integer", "minimum": 1, "maximum": 2305843009213693951 },
        "maxConcurrentRequests": { "type": "integer", "minimum": 1, "maximum": 2305843009213693951 },
        "requestRateLimitPerSecond": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "bucket", "prefix", "region", "timeouts"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "bucket": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" },
        "region": { "type": "string", "minLength": 1 },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectSeconds",
            "readSeconds",
            "operationAttemptSeconds",
            "operationSeconds",
            "stalledStreamGraceSeconds"
          ],
          "properties": {
            "connectSeconds": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "readSeconds": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "operationAttemptSeconds": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "operationSeconds": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "stalledStreamGraceSeconds": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reclamationEnabled",
        "renewalHorizonSeconds",
        "orphanPressureBytes",
        "orphanPressureCount",
        "orphanPressureMaxAgeSeconds",
        "maxIntervalSeconds",
        "minCooldownSeconds",
        "pacingDelayMs",
        "maxInventoryPages",
        "maxInventoryItems",
        "maxHistoryMetadataBytes",
        "maxHistoryPendingBytes"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["", "auto", "manual", "off"] },
        "reclamationEnabled": { "type": "boolean" },
        "renewalHorizonSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "orphanPressureBytes": { "type": ["integer", "null"], "minimum": 1 },
        "orphanPressureCount": { "type": ["integer", "null"], "minimum": 1 },
        "orphanPressureMaxAgeSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "maxIntervalSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "minCooldownSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "pacingDelayMs": { "type": ["integer", "null"], "minimum": 1 },
        "maxInventoryPages": { "type": ["integer", "null"], "minimum": 1 },
        "maxInventoryItems": { "type": ["integer", "null"], "minimum": 1 },
        "maxHistoryMetadataBytes": {
          "type": ["integer", "null"],
          "minimum": 1048576,
          "maximum": 8589934592
        },
        "maxHistoryPendingBytes": {
          "type": ["integer", "null"],
          "minimum": 25165824,
          "maximum": 1073741824
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicKey",
        "windowDays",
        "renewalMarginSeconds",
        "clockUncertaintyMs"
      ],
      "properties": {
        "point": { "type": "string", "pattern": "^$|^(0|[1-9][0-9]{0,19})$" },
        "publicKey": { "type": "string" },
        "windowDays": { "type": "integer", "minimum": 1, "maximum": 36500 },
        "renewalMarginSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "clockUncertaintyMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceSelector", "podSelector", "metrics"],
          "properties": {
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
            "podSelector": { "$ref": "#/definitions/labelSelector" },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespaceSelector", "podSelector"],
              "properties": {
                "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
                "podSelector": { "$ref": "#/definitions/labelSelector" }
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "kubeApi", "dns"],
          "properties": {
            "backend": { "$ref": "#/definitions/egressRule" },
            "kubeApi": { "$ref": "#/definitions/egressRule" },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to"],
              "properties": {
                "to": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              { "required": ["namespaceSelector"] },
              { "required": ["podSelector"] }
            ]
          }
        },
        {
          "anyOf": [
            { "required": ["namespaceSelector"] },
            { "required": ["podSelector"] }
          ],
          "not": { "required": ["ipBlock"] }
        }
      ],
      "properties": {
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "podSelector": { "$ref": "#/definitions/labelSelector" }
      }
    },
    "networkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "port"],
      "properties": {
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
        "port": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "endPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "ports"],
      "properties": {
        "to": {
          "type": "array",
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPort" }
        }
      }
    }
  }
}
