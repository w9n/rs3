{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceSelector", "podSelector", "metrics"],
          "properties": {
            "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
            "podSelector": { "$ref": "#/definitions/labelSelector" },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespaceSelector", "podSelector"],
              "properties": {
                "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
                "podSelector": { "$ref": "#/definitions/labelSelector" }
              }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "kubeApi", "dns"],
          "properties": {
            "backend": { "$ref": "#/definitions/egressRule" },
            "kubeApi": { "$ref": "#/definitions/egressRule" },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to"],
              "properties": {
                "to": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": {
            "anyOf": [
              { "required": ["namespaceSelector"] },
              { "required": ["podSelector"] }
            ]
          }
        },
        {
          "anyOf": [
            { "required": ["namespaceSelector"] },
            { "required": ["podSelector"] }
          ],
          "not": { "required": ["ipBlock"] }
        }
      ],
      "properties": {
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "podSelector": { "$ref": "#/definitions/labelSelector" }
      }
    },
    "networkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "port"],
      "properties": {
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
        "port": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "endPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "ports"],
      "properties": {
        "to": {
          "type": "array",
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPort" }
        }
      }
    }
  }
}
